[user]
	email = git@collinstevens.com
	name = Collin Stevens
	signingkey = ~/.ssh/id_ed25519

[core]
	editor = vim

[init]
	defaultBranch = master

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	useForceIfIncludes = true

[rebase]
	autoSquash = true
	updateRefs = true

[rerere]
	enabled = true

[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	rap = "!f(){ b=$(git symbolic-ref --quiet --short HEAD) || return; git fetch origin \"$b\" && git reset --hard \"origin/$b\"; }; f"
	acp = "!f(){ git add -A && git commit --amend --no-edit && git push --force-with-lease; }; f"
	ac = "!f(){ git add -A && git commit --amend --no-edit; }; f"
	pl = !git fetch -p && git branch -vv | grep \": gone]\" | awk \"{print \\$1}\" | xargs -r git branch -D

[fetch]
	prune = true

[gpg]
	format = ssh

[commit]
	gpgsign = true

[lfs]
	# GitHub doesn't implement the pure-SSH LFS protocol (git-lfs-transfer), so
	# git-lfs wastes 5-20s probing it before falling back to HTTPS - and can hang
	# outright under SSH multiplexing. Skip the probe and use the hybrid protocol.
	sshtransfer = never
	# WSL2's NAT intermittently stalls TLS handshakes to GitHub over 443. With the
	# defaults (8 parallel transfers, 30s dial/tls timeouts) a single stalled blob
	# upload hangs the whole push for minutes. Fewer parallel handshakes + shorter
	# timeouts make a stall abort and retry in ~15s instead.
	concurrenttransfers = 2
	dialtimeout = 10
	tlstimeout = 10
	activitytimeout = 15

[lfs "transfer"]
	maxretries = 5

[includeIf "gitdir/i:C:/"]
    path = ~/.gitconfig-windows

[includeIf "gitdir:/home/"]
    path = ~/.gitconfig-linux