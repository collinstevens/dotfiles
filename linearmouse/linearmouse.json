{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.3",
  "schemes" : [
    {
      "if" : {
        "device" : {
          "category" : "mouse"
        }
      },
      "scrolling" : {
        "reverse" : {
          "vertical" : true
        },
        "distance" : {
          "vertical" : 3
        }
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xb3",
          "productName" : "Razer HyperPolling Wireless Dongle",
          "vendorID" : "0x1532"
        }
      },
      "pointer" : {
        "disableAcceleration" : true
      }
    }
  ]
}
